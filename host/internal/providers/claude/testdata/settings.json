{
  "model": "opus",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "afplay /System/Library/Sounds/Glass.aiff" }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c 'node \"$HOME/.claude/hud/index.js\"'",
    "refreshInterval": 5
  },
  "enabledPlugins": { "x@y": true }
}
